# PostgreSQL used by the Docker Compose stack
POSTGRES_DB=guildpilot
POSTGRES_USER=guildpilot
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Local Python runs connect through the published host port.
# Docker Compose overrides DATABASE_URL for the bot service automatically.
DATABASE_URL=postgresql+psycopg2://guildpilot:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@localhost:5434/guildpilot

# Discord bot credentials
ROSA_DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
ROSA_DISCORD_CHANNEL_ID=YOUR_DISCORD_CHANNEL_ID
DISCORD_GUILD_ID=YOUR_TEST_GUILD_ID

# Optional: AI responses require an Anthropic API key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: URL shown by the sale-card button
LIVE_BOARD_URL=https://discord.com
